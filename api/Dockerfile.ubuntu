# Alternative Dockerfile using Ubuntu base for Payment Watchdog API
FROM ghcr.io/catthehacker/ubuntu:act-latest

# Install Go
RUN apt-get update && apt-get install -y \
    golang-go \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o payment-watchdog-api ./cmd/main.go

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["./payment-watchdog-api"]
