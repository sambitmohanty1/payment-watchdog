# OCI K3s Deployment Configuration
# Copy this file to .env and fill in the values

# ==========================================
# OCI Infrastructure Configuration
# ==========================================
TF_VAR_tenancy_ocid="ocid1.tenancy.oc1..xxxxxx"
TF_VAR_user_ocid="ocid1.user.oc1..xxxxxx"
TF_VAR_fingerprint="aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00"
TF_VAR_private_key_path="~/.oci/oci_api_key.pem"
TF_VAR_region="us-ashburn-1" # Update to your desired region
TF_VAR_compartment_ocid="ocid1.compartment.oc1..xxxxxx"
TF_VAR_ssh_public_key="ssh-rsa AAAAB3..."
TF_VAR_ssh_private_key_path="~/.ssh/id_rsa"
TF_VAR_k3s_token="super-secret-k3s-cluster-token-12345"
TF_VAR_instance_count=2

# ==========================================
# Kubernetes Application Secrets
# ==========================================
DOMAIN="watchdog.yourdomain.com"
EMAIL="admin@yourdomain.com"
DB_PASSWORD="your-secure-db-password"
REDIS_PASSWORD="your-secure-redis-password"
